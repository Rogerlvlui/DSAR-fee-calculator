{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "matterId": {
      "type": "string"
    },
    "rulePackId": {
      "type": "string"
    },
    "rulePackVersion": {
      "type": "string"
    },
    "engineVersion": {
      "type": "string"
    },
    "computedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "expenseLineId": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "ALLOW",
              "ALLOW_CAPPED",
              "DISALLOW",
              "FLAG"
            ]
          },
          "engineAmount": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "appliedRuleId": {
            "type": "string"
          },
          "appliedCap": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "PER_UNIT"
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "HOUR",
                          "PAGE",
                          "ITEM",
                          "GIGABYTE",
                          "FIXED"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "amount",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "PER_LINE"
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      }
                    },
                    "required": [
                      "type",
                      "amount"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "PER_MATTER"
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      }
                    },
                    "required": [
                      "type",
                      "amount"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "PERCENT_OF_CLAIM"
                      },
                      "percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "type",
                      "percent"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "type": "string",
            "maxLength": 240
          },
          "citation": {
            "type": "object",
            "properties": {
              "instrument": {
                "type": "string"
              },
              "provision": {
                "type": "string"
              },
              "guidance": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "instrument",
              "provision"
            ],
            "additionalProperties": false
          },
          "flagReasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "NO_FEE_AUTHORITY",
                    "CONDITIONS_NOT_MET",
                    "POSSIBLE_DUPLICATE",
                    "RATE_ABOVE_EXPECTED",
                    "MATERIALITY",
                    "DATA_QUALITY",
                    "VENDOR_EVIDENCE_MISSING",
                    "UNCATEGORISED",
                    "AGGREGATE_CAP_APPLIED"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REDUCED",
              "STRUCK",
              "ALLOWED_BY_LAWYER"
            ]
          },
          "lawyerAmount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "lawyerReason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "dispositionedBy": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "ulid",
                    "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": [
                  "id",
                  "displayName",
                  "email"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "dispositionedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "expenseLineId",
          "verdict",
          "engineAmount",
          "appliedRuleId",
          "appliedCap",
          "basis",
          "citation",
          "flagReasons",
          "disposition",
          "lawyerAmount",
          "lawyerReason",
          "dispositionedBy",
          "dispositionedAt"
        ],
        "additionalProperties": false
      }
    },
    "matterLevelFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "LITIGATION_POSTURE",
              "REPEAT_REQUEST",
              "STALE_PACK_WARNING",
              "NO_FEE_AUTHORITY_POSTURE",
              "PACK_FLAG",
              "AGGREGATE_CAP_APPLIED"
            ]
          },
          "message": {
            "type": "string"
          },
          "requiresAcknowledgement": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "code",
          "message",
          "requiresAcknowledgement"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "claimedTotal": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "draftBaseline": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "disallowedTotal": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "flaggedTotal": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "restingOnUnverifiedRules": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "finalAmount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "flatFeeComparison": {
          "type": "object",
          "properties": {
            "flatFeeAmount": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "itemisedDirectCostAmount": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "flatFeeExceedsItemisedCost": {
              "type": "boolean"
            }
          },
          "required": [
            "flatFeeAmount",
            "itemisedDirectCostAmount",
            "flatFeeExceedsItemisedCost"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "claimedTotal",
        "draftBaseline",
        "disallowedTotal",
        "flaggedTotal",
        "restingOnUnverifiedRules",
        "finalAmount"
      ],
      "additionalProperties": false
    },
    "signOff": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lawyer": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "ulid",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                },
                "displayName": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                }
              },
              "required": [
                "id",
                "displayName",
                "email"
              ],
              "additionalProperties": false
            },
            "lawyerName": {
              "type": "string"
            },
            "qualification": {
              "type": "string",
              "maxLength": 200
            },
            "signedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "finalAmount": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "acknowledgedFlags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attestation": {
              "type": "boolean",
              "const": true
            },
            "attestationVersion": {
              "type": "string"
            }
          },
          "required": [
            "lawyer",
            "lawyerName",
            "qualification",
            "signedAt",
            "finalAmount",
            "acknowledgedFlags",
            "attestation",
            "attestationVersion"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "feeChoice": {
      "type": "string",
      "enum": [
        "ITEMISED",
        "FLAT"
      ]
    }
  },
  "required": [
    "id",
    "matterId",
    "rulePackId",
    "rulePackVersion",
    "engineVersion",
    "computedAt",
    "lines",
    "matterLevelFlags",
    "totals",
    "signOff"
  ],
  "additionalProperties": false
}
