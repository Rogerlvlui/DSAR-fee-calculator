{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Widened from "." (tests/ itself) to ".." (the repo root): 03.1-01's
    // tests/routes/demo-pipeline.test.ts imports apps/web route handlers
    // directly for the tracer's proof, which sit outside tests/'s own
    // directory. A composite project's rootDir must be a common ancestor of
    // every file the program reaches, or `tsc --build` refuses with TS6059/
    // TS6307 — apps/web is deliberately NOT a project reference (see
    // apps/web/tsconfig.json's own note), so widening this project's rootDir
    // is the fix, not adding a reference. dist/ is gitignored and consumed
    // by nothing else in the repo, so the resulting deeper output nesting
    // under outDir is harmless.
    "rootDir": "..",
    "outDir": "../dist/tests",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  // Targeted, not a blanket "../apps/web/**" glob: rootDir only says WHERE a
  // file may live, "include" says WHICH files are added to the program — a
  // file outside "include" is still TS6307 even once it satisfies rootDir.
  // apps/web is otherwise typechecked on its own via
  // `tsc -p apps/web/tsconfig.json` (see that file's own note, "bundler"
  // resolution); these two globs cover exactly the route handlers and
  // server/data-layer modules tests/routes/*.test.ts imports, under this
  // project's inherited "nodenext" resolution. Deliberately NOT
  // "../apps/web/app/**" or "../apps/web/src/**" wholesale: those also match
  // apps/web/src/server/current-actor.ts, apps/web/app/layout.tsx and the
  // page.tsx files, none of which any routes test imports, and
  // current-actor.ts's "next/headers" import does not resolve under
  // "nodenext" (next ships no "exports" map) the way it does under
  // apps/web/tsconfig.json's "bundler" resolution.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../apps/web/app/api/**/*.ts",
    "../apps/web/src/server/**/*.ts"
  ],
  "exclude": ["node_modules", "../apps/web/src/server/current-actor.ts"]
}
