# .env.example
#
# D-08: two separate connection strings, on purpose. If the running app ever
# boots on DATABASE_URL "because it's simpler," the dsar_migrator/dsar_runtime
# split (D-06, AUDIT-02) is silently unenforced. Phase 3.2 wires a boot-time
# assertion (`SELECT current_user`) that fails fast if the app connects as
# dsar_migrator; this plan only establishes the two-variable shape it checks.
#
# Neither role exists until Phase 3.2's hand-edited migration creates them.

# Used ONLY by `prisma migrate` (via prisma.config.ts) — connects as the
# privileged dsar_migrator role. Never used by the running app.
DATABASE_URL="postgresql://dsar_migrator:replace-with-a-real-password@localhost:5432/dsar?schema=public"

# Used ONLY by the running Next.js app — connects as the restricted
# dsar_runtime role, which has no UPDATE/DELETE/TRUNCATE on AuditEvent
# (AUDIT-02). Never used by `prisma migrate`.
RUNTIME_DATABASE_URL="postgresql://dsar_runtime:replace-with-a-real-password@localhost:5432/dsar?schema=public"
